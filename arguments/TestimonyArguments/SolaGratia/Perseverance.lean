  /-- Nor must the Lutherans be accepted, for the same reason. -/
  proves @[headline] lutheran_on_perseverance_not_forced

#print axioms lutheran_on_perseverance_not_forced

/-- Why Wesley can be defended on perseverance. -/
declare_verdict wesleyDefendedOnPerseverance for perseveranceDispute :
