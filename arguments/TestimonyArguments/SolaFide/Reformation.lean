  | .zwingli => zwingliCase
  | .eck => eckCase
  | .tyndale => tyndaleCase
  | .augsburg => augsburgCase
  | .confutation => confutationCase
  | .apology => apologyCase
  | .barnes => barnesCase
  | .cajetan => cajetanCase
