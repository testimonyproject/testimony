import Testimony.Tools.Pages

/-!
# Testimony.Tools.Site — each argument as a page of the documentation site

The Markdown counterpart of `latexDocument`. A harvested body (`Body`) is the
argument; this is the shell around it — the page's title, the standing note
under the title, the do-not-edit header — and the run that writes a package's
pages, splices the list of them into the marked block of the site's summary,
and with `--check` fails if a committed page is not what the source now says.

A package built on the library describes where its pages go (`Site`), names
its arguments (a catalogue of `Argument`s), harvests them
(`derive_argument_bodies … under N`), and calls `Site.run`.
-/

namespace Testimony.Doc

/-- Where a package's pages go, and where its sources are. -/
structure Site where
  /-- The generator, as the do-not-edit header and the summary's markers name
  it: `argdoc`. -/
  tool : String
  /-- The repository path the package's sources sit under, before a namespace's
  own path: `arguments/`, for a package in that directory. -/
  sourceRoot : String := ""
  /-- The directory the pages are written to. -/
  pagesDir : System.FilePath
  /-- The site's summary, whose marked block lists the pages. -/
  summaryPath : System.FilePath

namespace Site

/-- The repository path an argument's sources live at. -/
def source (s : Site) (a : Argument) : String := s.sourceRoot ++ sourcePath a.ns

/-- The note every generated page opens with, under its title.

It says three things a reader meets in the first screen and would otherwise
have to infer: that the prose is the source's own, what the numbering is, and
what the two marks mean. -/
def preamble (s : Site) (a : Argument) : String :=
  "*This page is generated from [`" ++ s.source a ++ "`](https://github.com/" ++
  "testimonyproject/testimony/blob/main/" ++ s.source a ++ "). Every heading and " ++
  "paragraph below is a docstring in those files; every formula is rendered from the " ++
  "encoding they check. If the page and the source disagree, the page is the one that " ++
  "is wrong, and regenerating it is the fix.*\n\n" ++
  "Atoms are numbered propositional variables, numbered once for the whole page, so " ++
  "the same variable means the same claim in every position below. " ++
  "[Reading the logic](../reading-the-logic.md) is the short version of what the " ++
  "notation means. A result marked ⚗ is one this library constructs rather than " ++
  "reports.\n\n"

/-- One argument's page: the do-not-edit header, the title, the note, the
generated body. -/
def page (s : Site) (a : Argument) (b : Body) : String :=
  "<!-- Generated by `lake exe " ++ s.tool ++ "`. Do not edit by hand. -->\n" ++
  "<!-- Source of truth: " ++ s.source a ++ " -->\n\n" ++
  "# " ++ a.title ++ "\n\n" ++ s.preamble a ++ b.markdown

/-- Every page, as a file name under the pages directory and its contents, in
the catalogue's order. -/
def pages (s : Site) (catalogue : List Argument) (harvest : List Body) :
    List (String × String) :=
  (sectionsOf catalogue harvest).map fun (a, b) => (a.slug ++ ".md", s.page a b)

/-- The block the generator owns in the site's summary: a link to each page. -/
def summaryMarkdown (catalogue : List Argument) : String :=
  String.join (catalogue.map fun a =>
    "- [" ++ a.title ++ "](./arguments/" ++ a.slug ++ ".md)\n")

/-- Opening marker of the block the generator owns in the summary. -/
def beginMarker (s : Site) : String := "<!-- BEGIN GENERATED: lake exe " ++ s.tool ++ " -->"

/-- Closing marker. -/
def endMarker (s : Site) : String := "<!-- END GENERATED: lake exe " ++ s.tool ++ " -->"

/-- Pages present in the pages directory that the generator does not write.

An argument that is renamed or removed leaves its old page behind, and a stale
page asserting a result the library no longer has is the failure this project
exists to rule out. Reported rather than deleted: the tool says what to remove,
and a human removes it. -/
def strayPages (s : Site) (wanted : List String) : IO (Array System.FilePath) := do
  unless ← s.pagesDir.pathExists do return #[]
  let mut stray := #[]
  for entry in ← s.pagesDir.readDir do
    let name := entry.fileName
    if name.endsWith ".md" && !wanted.contains name then
      stray := stray.push entry.path
  return stray.qsort (·.toString < ·.toString)

/-- **Write the pages and the summary's block, or check them**: with `--check`,
report each stale page, a stale block and every stray page, and fail;
otherwise write them all. Returns the exit code. -/
def run (s : Site) (catalogue : List Argument) (harvest : List Body) (args : List String) :
    IO UInt32 := do
  unless ← s.summaryPath.pathExists do
    IO.eprintln s!"{s.tool}: {s.summaryPath} does not exist"
    return 1
  let summary ← IO.FS.readFile s.summaryPath
  let body := summaryMarkdown catalogue ++ "\n"
  let updated ← match Testimony.Logic.Markdown.splice s.beginMarker s.endMarker summary body with
    | .error e => do IO.eprintln s!"{s.tool}: {s.summaryPath}: {e}"; return 1
    | .ok t => pure t
  let pages := s.pages catalogue harvest
  let stray ← s.strayPages (pages.map (·.1))
  if args.contains "--check" then
    let mut ok := true
    for (name, text) in pages do
      if (← readGenerated (s.pagesDir / name)) != text then
        IO.eprintln s!"{s.tool}: {s.pagesDir / name} is stale"
        ok := false
    if summary != updated then
      IO.eprintln s!"{s.tool}: the generated block in {s.summaryPath} is stale"
      ok := false
    for p in stray do
      IO.eprintln s!"{s.tool}: {p} is not generated by {s.tool} — delete it"
      ok := false
    if ok then
      IO.println s!"{s.tool}: {pages.length} argument pages are up to date"
      return 0
    IO.eprintln s!"{s.tool}: run `lake exe {s.tool}` and commit the result"
    return 1
  IO.FS.createDirAll s.pagesDir
  for (name, text) in pages do
    IO.FS.writeFile (s.pagesDir / name) text
  IO.FS.writeFile s.summaryPath updated
  for p in stray do
    IO.eprintln s!"{s.tool}: warning: {p} is not generated by {s.tool} — delete it"
  IO.println s!"{s.tool}: wrote {pages.length} pages to {s.pagesDir} and updated {s.summaryPath}"
  return 0

end Site

end Testimony.Doc
