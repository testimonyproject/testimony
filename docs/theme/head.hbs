<!-- Testimony — injected into <head> of every page by mdBook.

     Favicons: mdBook's default theme already links theme/favicon.png and
     theme/favicon.svg, which we override with the simplified mark. The
     apple-touch-icon and manifest icons are additional.

     Open Graph and Twitter card tags use absolute URLs deliberately: social
     scrapers do not resolve relative paths. They point at the canonical site,
     so a link shared from any page renders the banner. -->

<link rel="apple-touch-icon" href="https://testimonyproject.info/assets/testimony-192.png">

<meta property="og:site_name" content="Testimony">
<meta property="og:type" content="website">
<meta property="og:title" content="Testimony">
<meta property="og:description" content="Machine-checkable models of biblical arguments, with every premise sourced and contestable.">
<meta property="og:url" content="https://testimonyproject.info/">
<meta property="og:image" content="https://testimonyproject.info/assets/testimony-social-1280x640.png">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta property="og:image:alt" content="Testimony — a turnstile with an inscribed cross, beside the project name.">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Testimony">
<meta name="twitter:description" content="Machine-checkable models of biblical arguments, with every premise sourced and contestable.">
<meta name="twitter:image" content="https://testimonyproject.info/assets/testimony-social-1280x640.png">
